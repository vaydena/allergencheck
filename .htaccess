# AllergenCheck – Hostinger/Apache
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType application/json .json
AddDefaultCharset UTF-8
DirectoryIndex index.html

# HTTP -> HTTPS (Kamera, Service Worker und Krypto-API funktionieren nur ueber HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|svg|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|deploy-version\.txt|zutaten\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  Header set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
</IfModule>
